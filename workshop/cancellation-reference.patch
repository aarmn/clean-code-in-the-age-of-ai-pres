+def test_cancelling_twice_returns_empty_responses() -> None:
+    store = MemoryBookingStore()
+    with TestClient(create_app(store)) as client:
+        payload = {"booking_id": "A42", "seats": 2}
+        assert client.post("/bookings", json=payload).status_code == 201
+
+        first = client.delete("/bookings/A42")
+        repeated = client.delete("/bookings/A42")
+
+        assert first.status_code == repeated.status_code == 204
+        assert first.content == repeated.content == b""
+        assert store.get("A42") == Booking("A42", 2, cancelled=True)
+        assert client.post("/bookings", json=payload).status_code == 409
+
+
+def test_unknown_booking_returns_not_found() -> None:
+    with TestClient(create_app()) as client:
+        response = client.delete("/bookings/unknown")
+        assert response.status_code == 404
+        assert response.json() == {"detail": "Booking ID does not exist"}
+
+
+def test_openapi_documents_cancel_without_a_success_body() -> None:
+    with TestClient(create_app()) as client:
+        schema = client.get("/openapi.json").json()
+        responses = schema["paths"]["/bookings/{booking_id}"]["delete"]["responses"]
+        assert {"204", "404"} <= responses.keys()
+        assert "content" not in responses["204"]
